## ── OUTBREAK PACK — START ORDER (paste at the END of server.cfg) ──────────────
## Foundation must already be ensured above this block by the Qbox recipe:
##   oxmysql, ox_lib, qbx_core, ox_inventory, ox_target, pma-voice, illenium-appearance
## Disable before first boot (comment out in the recipe's cfgs):
##   qbx_spawn, qbx_properties, qbx_hud, qbx_medical, qbx_ambulancejob, qbx_police,
##   npwd + qbx_npwd + npwd_qbx_*, ox_fuel, qbx_density

setr ob_debug 1                 # 1 during the shakedown, 0 for the crew
set  ob_scenario "motel"        # motel | airport | paleto
add_ace group.admin outbreak.debug allow
add_ace group.admin outbreak.admin allow   # /ob_revive <id> — glitch insurance, keep this one for the crew
add_ace group.admin outbreak.dm allow      # Director menu (F10 / wheel) — you, and whoever else runs events

## Layer 0 — presentation with no deps
ensure outbreak_minigames
ensure outbreak_binds
## Layer 1 — services
ensure outbreak_core            # tick bus, zombies, world events  (needs ox_lib)
ensure outbreak_world           # clock/weather (exports read by spawn)
ensure outbreak_emotes          # action anims (needs core tick)
ensure outbreak_noise           # needs core tick
ensure outbreak_radio           # transmit service (needs pma-voice, emotes)
ensure outbreak_needs           # character state (needs core, ox_inventory)
ensure outbreak_spawn           # needs needs, radio, world
ensure outbreak_identity        # needs illenium-appearance, spawn
ensure outbreak_skills          # needs identity (traits)
ensure outbreak_items           # useables + loot (needs needs, emotes)
ensure outbreak_housing         # needs items, minigames, emotes
ensure outbreak_down            # needs needs, emotes, housing
ensure outbreak_faction         # reputation service
ensure outbreak_weapons         # catalog + rules on ox_inventory durability (merge data/weapons_snippet.lua)
ensure outbreak_worlditems      # mutable world: place/take/storage/notes + entropy (006_worlditems.sql)
ensure outbreak_dm              # director menu (007_dm.sql) - ace outbreak.dm
## Layer 2 — presentation that reads everything
ensure outbreak_hud
ensure outbreak_status       # F1 status panel (reads client exports only)
ensure outbreak_wheel
## Debug — REMOVE for the crew
ensure outbreak_debug

## ── VEHICLES v2 (server-authoritative - prerequisite for chain 2 and war rigs) ───
# ensure outbreak_vehicles          # after outbreak_core, ox_inventory, outbreak_minigames, outbreak_emotes - apply 004_vehicles.sql

## ── PROGRESSION (HELD until DESIGN-progression.md review + slice pass) ─────────
